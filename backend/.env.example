PORT=8000

# Banco principal (Neon). Para Postgres local sem SSL, use DB_SSL=false
DATABASE_URL=postgresql://usuario:senha@seu-host.neon.tech/banco?sslmode=require
DB_SSL=true

# Banco SEPARADO usado apenas por "npm test" (as tabelas são apagadas a cada execução)
DATABASE_URL_TEST=

# Segredo para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Endereço do frontend liberado no CORS (separe vários por vírgula)
FRONTEND_URL=http://localhost:5173

# Fuso usado para definir "hoje" e "mês atual"
APP_TIMEZONE=America/Sao_Paulo
